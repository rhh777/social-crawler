# Social Crawler 全局配置模板。复制为 .env.local（本机）或 .env.deploy（Docker/K8s）后修改。
# 完整配置地图、优先级、账号/任务字段：docs/guides/configuration.md
# 本地启动 / CLI / Web 自动读取；改后重启。进程环境变量优先于文件。
# 字面值，不支持 ${VAR} 引用或 shell 命令；含 #、空格、$ 的值请用单引号包裹。
# 未启用的可选项保持注释，不能随意改成空值（端口、布尔值等要求有效值）。

# ── 常用：服务与数据库 ───────────────────────────────────────
CRAWLER_WEB_PORT=8765
CRAWLER_WORKERS=2
# 本地监听地址；Compose 容器内固定 0.0.0.0，宿主机绑定见下面的 Compose 项。
# CRAWLER_WEB_HOST=127.0.0.1
# 本地/直接启动 Web 的数据根目录；本地脚本默认 ./social-crawler-local。
# CRAWLER_ROOT=/absolute/path/social-crawler-local
# 兼容旧变量，仅本地脚本使用，CRAWLER_ROOT 优先：
# CRAWLER_LOCAL_DIR=/absolute/path/social-crawler-local
# 留空或不设置时：本地脚本自动启动 PostgreSQL；CLI/Web 读取 data/postgres.url。
# 配置后本地脚本直接连接该数据库，不再启动或停止自带的 PostgreSQL。
# Compose 始终使用其 postgres 服务，不采用此本机连接串。
# CRAWLER_DATABASE_URL=postgresql+psycopg://crawler:password@127.0.0.1:5432/crawler
# 下载媒体/采集产物目录；相对路径以 Web 运行根目录为基准。
# CRAWLER_ARTIFACTS_DIR=artifacts
# 跳过依赖和浏览器安装（第一次运行不能启用）。
# CRAWLER_SKIP_SETUP=1
# 额外允许的 Web Host，逗号分隔；本机访问通常不需要。
# CRAWLER_WEB_ALLOWED_HOSTS=crawler.example.com

# ── AdsPower ───────────────────────────────────────────────
# AdsPower CLI 运行服务的启动密钥，不是某个账号的 profile ID。
# 本机桌面版仍由 AdsPower 自己登录管理；采集器不会自动启动 AdsPower 服务。
# K8s 同步：uv run python scripts/sync_adspower_secret.py --context YOUR_CONTEXT
# 对应 Secret：adspower-api / api-key；同步后需自行重启相应 Pod。
ADS_API_KEY=
# 新账号 / 缺省 TOML 环境配置使用的默认值；已保存的账号字段优先。
# 仅支持 loopback；K8s AdsPower sidecar 与采集器必须在同一 Pod。
CRAWLER_ADSPOWER_API_URL=http://127.0.0.1:50325
CRAWLER_ADSPOWER_START_TIMEOUT=90
# profile ID、browser_provider 在 Web 账号管理或 TOML [environment] 中配置。
# 运行容器高级变量（仅直接运行 AdsPower entrypoint 时读取，K8s 仍在 overlay 配置）：
# ADS_KERNEL_VERSION=151
# PORT=50325
# ADS_HEALTH_TIMEOUT=5
# 连续健康检查失败次数；Compose 默认 18，避免浏览器繁忙时误杀 sidecar。
# ADS_HEALTH_FAILURES=18
# ADS_READY_FILE=/tmp/adspower-ready

# ── Kameleo（本机桌面版）──────────────────────────────────
# 启动 Kameleo 桌面应用并保持 Local API 可用。首版只支持本机桌面 Chrome profile；
# profile UUID、browser_provider 在 Web 账号管理或 TOML [environment] 中配置。
CRAWLER_KAMELEO_API_URL=http://127.0.0.1:5050
CRAWLER_KAMELEO_START_TIMEOUT=90

# ── 手动 Agent 分析（可选）─────────────────────────────────
# 不配置不影响采集；仅用户发送分析消息时调用模型。
# 已在页面保存过的 Agent 设置优先；迁移到环境配置文件见配置指南。
ANTHROPIC_API_KEY=
CRAWLER_AGENT_API_URL=https://api.anthropic.com
CRAWLER_AGENT_MODEL=sonnet
# 兼容变量：只有未设置 CRAWLER_AGENT_API_URL 时使用。
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── 浏览器和代理 ──────────────────────────────────────────
# 新建 Web 默认账号的无头模式；已有账号在页面修改；本地默认 false，Compose true。
# CRAWLER_DEFAULT_HEADLESS=false
# 自定义 Chromium 可执行文件（本地路径）；不设则使用 Playwright 默认浏览器。
# Docker 镜像已有固定浏览器路径；账号 browser_channel 优先于该变量。
# CRAWLER_BROWSER_EXECUTABLE_PATH=/absolute/path/to/chrome
# 代理凭据可以放在此处：账号 proxy_env 填 CRAWLER_XHS_PROXY 等变量名。
# 只写变量不会自动给账号启用代理；也可以继续用账号的 proxy_file。
# CRAWLER_XHS_PROXY='http://username:password@proxy.example:8080'
# CRAWLER_REDNOTE_PROXY='socks5://username:password@proxy.example:1080'
# CRAWLER_DOUYIN_PROXY='http://username:password@proxy.example:8080'
# 可选代理中继，不是 Docker/Kubernetes 的必需组件；容器或 Pod 能直连上游代理时保持为空。
# 当前 deploy/k8s 清单不会启用中继。本机 start_local.sh 也应保持为空，避免把可用代理
# 改写到仅供容器访问的宿主机地址。仅在 macOS/OrbStack 容器无法直连、但宿主机可以
# 连接上游代理时启用，并同时运行 scripts/host_proxy_relay.py。
# 映射格式：上游主机:端口=宿主机监听端口，多个映射用逗号分隔。
CRAWLER_PROXY_RELAY_HOST=
CRAWLER_PROXY_RELAY_MAP=

# ── Docker Compose 专用 ────────────────────────────────────
# 应用和可选 AdsPower sidecar 固定使用 linux/amd64；PostgreSQL 保持宿主机原生架构。
# 已初始化 PostgreSQL 后，修改此密码不会自动更改数据库里的用户密码。
POSTGRES_PASSWORD=local-development-only
CRAWLER_COMPOSE_BIND_HOST=127.0.0.1
CRAWLER_POSTGRES_PORT=5433
# 验证报告中的镜像标识（构建/部署时填）。
# CRAWLER_IMAGE_DIGEST=sha256:...

# Cookie 和浏览器 Profile 是运行数据，放在 data/cookies/、profiles/；不要粘贴到这里。
# 选择其他配置文件：在进程环境设置 CRAWLER_ENV_FILE=/absolute/path/private.env。
# Compose 使用 docker compose --env-file /absolute/path/private.env up -d。
